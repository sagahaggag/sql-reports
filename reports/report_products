/*
==========================================================================================
Product Report
==========================================================================================
Purpose:
	- This report consolidates key product metrics and behaviours.

Highlights:
	1. Gathers essential fields such as product name, category, subcategory, and cost.
	2. Segments products by revenue to identify high-performers, mid-range, or low-performers.
	3. Aggregates product-level metrics:
		- total orders
		- total sales
		- total quantity sold
		- total customers (unique)
		- lifespan (in months)
	4. Calculates valuable KPIs:
		- recency (month since last sales)
		- average order revenue (AOR)
		- monthly order revenue
==========================================================================================
*/
CREATE VIEW gold.report_products AS
WITH basic_query AS (
/* ------------------------------------------------------------------------------------------------
1) Base Query: Retrieve core columns from the tables
-------------------------------------------------------------------------------------------------*/
SELECT
    f.order_number,
    f.order_date,
	f.customer_key,
    f.sales_amount,
    f.quantity,
    p.product_key,
    p.product_name,
    p.category,
    p.subcategory,
    p.cost
FROM gold.fact_sales f
LEFT JOIN gold.dim_products p
    ON f.product_key = p.product_key
WHERE f.order_date IS NOT NULL
),
product_aggregations AS (
/*-------------------------------------------------------------------------------------------------------
2) Product Aggregations: Summarizes key metrics at the product level
-------------------------------------------------------------------------------------------------------*/
SELECT
	product_key,
	product_name,
	category,
	subcategory,
	cost,
	DATEDIFF(MONTH, MIN(order_date), MAX(order_date)) AS lifespan,
	MAX(order_date) AS last_order_date,
	COUNT(DISTINCT order_number) AS nr_of_orders,
	COUNT(DISTINCT customer_key) AS nr_of_customers,
	SUM(sales_amount) AS total_sales,
	SUM(quantity) AS total_quantity,
ROUND(AVG(CAST(sales_amount AS FLOAT) / NULLIF(quantity, 0)), 1) AS avg_selling_point
FROM basic_query
GROUP BY
product_key,
product_name,
category,
subcategory,
cost
)
/*---------------------------------------------------------------------------------------------
3) Final Query: Combine all product results into one output
---------------------------------------------------------------------------------------------*/
SELECT
	product_key,
	product_name,
	category,
	subcategory,
	cost,
	last_order_date,
	DATEDIFF(MONTH, last_order_date, GETDATE()) AS recency,
	CASE WHEN total_sales > 50000 THEN 'High-performer'
		 WHEN total_sales >= 10000 THEN 'Mid-performer'
		 ELSE 'Low-performer'
	END AS product_segment,
	lifespan,
	nr_of_orders,
	total_sales,
	total_quantity,
	nr_of_customers,
	avg_selling_point,
-- Compute average order revenue (AOR)
	CASE WHEN nr_of_orders = 0 THEN 0
		 ELSE total_sales / nr_of_orders
	END AS avg_order_revenue,
-- Compute monthly order revenue
	CASE WHEN lifespan = 0 THEN total_sales
		 ELSE total_sales / lifespan
	END AS avg_monthly_revenue
FROM product_aggregations;
